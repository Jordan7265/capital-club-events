---
/**
 * Mock reservation form. Purely client-side: validation, a ~1s "Submitting…" state and a
 * confirmation panel with a fake code. It never makes a network request, and without
 * JavaScript the submit button stays disabled so nothing can be sent.
 */
import type { VenueEvent } from '../data/events';
import { confirmationStem, longDate, priceAmount, timeRange } from '../lib/format';
import FormField from './FormField.astro';

interface Props {
  event: VenueEvent;
  submitLabel?: string;
  id?: string;
}

const { event, submitLabel = 'Reserve my spot', id = 'reserve' } = Astro.props;

const f = (name: string) => `${id}-${name}`;
const guestOptions = Array.from({ length: 10 }, (_, i) => i + 1);
const defaultGuests = 2;
const perLabel = event.price.per === 'couple' ? 'per couple' : 'per guest';
---

<div
  class="mf mf--reservation"
  data-mock-form="reservation"
  data-code-stem={confirmationStem(event.start)}
  data-price-amount={event.price.amount}
  data-price-per={event.price.per}
>
  <form class="mf__form" novalidate data-mf-form aria-labelledby={f('title')}>
    <p class="visually-hidden" id={f('title')}>Reserve for {event.title}</p>

    <FormField id={f('name')} name="name" label="Full name">
      <input class="mf__input" id={f('name')} name="name" type="text" autocomplete="name" required aria-describedby={f('name-error')} />
    </FormField>

    <FormField id={f('email')} name="email" label="Email">
      <input class="mf__input" id={f('email')} name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby={f('email-error')} />
    </FormField>

    <FormField id={f('phone')} name="phone" label="Phone" optional>
      <input class="mf__input" id={f('phone')} name="phone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby={f('phone-error')} />
    </FormField>

    <FormField id={f('guests')} name="guests" label="Number of guests">
      <select class="mf__input mf__select" id={f('guests')} name="guests" required aria-describedby={f('guests-error')}>
        {
          guestOptions.map((n) => (
            <option value={n} selected={n === defaultGuests}>
              {n} {n === 1 ? 'guest' : 'guests'}
            </option>
          ))
        }
      </select>
    </FormField>

    <FormField id={f('notes')} name="notes" label="Dietary notes" optional>
      <textarea class="mf__input mf__textarea" id={f('notes')} name="notes" rows="3" maxlength="500" aria-describedby={f('notes-error')}></textarea>
    </FormField>

    <div class="mf__footer">
      <p class="mf__total">
        <span class="mf__total-label">Estimated total</span>
        <output class="mf__total-value" data-mf-total for={f('guests')}>
          {priceAmount(event.price)} {perLabel}
        </output>
      </p>
      <button type="submit" class="mf__submit" data-mf-submit disabled>
        <span data-mf-submit-label>{submitLabel}</span>
      </button>
    </div>

    <p class="mf__status visually-hidden" role="status" aria-live="polite" data-mf-status></p>
    <noscript>
      <p class="mf__noscript">
        Reservations on this page need JavaScript. Nothing you type here is sent anywhere.
      </p>
    </noscript>
  </form>

  <div class="mf__confirmation" data-mf-confirmation hidden>
    <p class="mf__confirm-kicker">Reservation received</p>
    <h3 class="mf__confirm-title" tabindex="-1" data-mf-confirm-heading>You’re on the list!</h3>
    <p class="mf__confirm-lede" data-fill="greeting">We’ve saved your spot.</p>
    <p class="mf__confirm-note" data-fill="emailNote">Check your email for your confirmation.</p>
    <dl class="mf__confirm-details">
      <div>
        <dt>Confirmation</dt>
        <dd class="mf__code" data-fill="code"></dd>
      </div>
      <div>
        <dt>Event</dt>
        <dd>{event.title}</dd>
      </div>
      <div>
        <dt>Date</dt>
        <dd><span class="mf__nowrap">{longDate(event.start)}</span> · <span class="mf__nowrap">{timeRange(event)}</span></dd>
      </div>
      <div>
        <dt>Guests</dt>
        <dd data-fill="guests"></dd>
      </div>
    </dl>
    <button type="button" class="mf__again" data-mf-reset>Make another reservation</button>
  </div>
</div>

<script>
  import { initReservationForms } from '../scripts/reservation-form';
  initReservationForms();
</script>
