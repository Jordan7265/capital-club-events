---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/jost';
import './a.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MockupBar from '../../components/MockupBar.astro';
import { venue } from '../../data/events';
import { fullAddress } from '../../lib/format';

interface Props {
  title: string;
  current: 'home' | 'events' | 'event';
  description?: string;
}
const { title, current, description } = Astro.props;
const base = '/mockups/a';
const nav = [
  { label: 'Upcoming Events', href: `${base}/events`, key: 'events' },
  { label: 'Photos', href: `${base}#photos`, key: 'photos' },
  { label: 'Contact', href: '#contact', key: 'contact' },
];
---

<BaseLayout title={title} description={description} bodyClass="dir-a" themeColor="#0b0d12">
  <a class="skip-link" href="#main">Skip to content</a>
  <MockupBar dir="a" current={current} />
  <div class="a-shell">
    <header class="a-header">
      <a class="a-header__brand" href={base} aria-label={`${venue.name} — home`}>
        <img src="/images/venue/logo.png" alt="" width="392" height="380" />
        <span class="a-header__wordmark" aria-hidden="true">
          <span>The Capital Club</span>
          <span>Rooftop Events · Asheville</span>
        </span>
      </a>
      <nav class="a-nav" aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="a-footer" id="contact">
      <div class="a-footer__grid">
        <div class="a-footer__brand">
          <img src="/images/venue/logo.png" alt={venue.name} width="392" height="380" loading="lazy" />
          <p>Benefits, tastings and late nights on the rooftop, in the heart of downtown Asheville.</p>
        </div>
        <div>
          <h2 class="a-eyebrow">Visit</h2>
          <address>
            {venue.name}<br />
            {venue.street}<br />
            {venue.city}, {venue.region} {venue.postalCode}
          </address>
          <a class="a-link" href={venue.mapHref} rel="noopener" target="_blank">
            Get directions<span class="visually-hidden"> to {fullAddress()} (opens in a new tab)</span>
          </a>
        </div>
        <div>
          <h2 class="a-eyebrow">Call</h2>
          <a class="a-footer__phone" href={venue.phoneHref}>{venue.phone}</a>
          <p class="a-footer__hours">Event office hours by appointment</p>
        </div>
        <nav aria-label="Footer">
          <h2 class="a-eyebrow">Explore</h2>
          <ul>
            {nav.map((item) => <li><a class="a-link" href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>
      <div class="a-footer__base">
        <p>© 2026 {venue.name}</p>
        <p class="a-footer__demo">Demonstration site — reservations and messages are not processed.</p>
      </div>
    </footer>
  </div>
</BaseLayout>
