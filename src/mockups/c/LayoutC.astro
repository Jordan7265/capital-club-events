---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/figtree';
import './c.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MockupBar from '../../components/MockupBar.astro';
import Ridges from './Ridges.astro';
import { venue } from '../../data/events';
import { fullAddress } from '../../lib/format';

interface Props {
  title: string;
  current: 'home' | 'events' | 'event';
  description?: string;
}
const { title, current, description } = Astro.props;
const base = '/mockups/c';
const nav = [
  { label: 'Upcoming Events', href: `${base}/events`, key: 'events' },
  { label: 'Photos', href: `${base}#photos`, key: 'photos' },
  { label: 'Contact', href: '#contact', key: 'contact' },
];
---

<BaseLayout title={title} description={description} bodyClass="dir-c" themeColor="#fbf5ec">
  <a class="skip-link" href="#main">Skip to content</a>
  <MockupBar dir="c" current={current} />
  <header class="c-header">
    <a class="c-brand" href={base} aria-label={`${venue.name} — home`}>
      <span class="c-brand__mark"><img src="/images/venue/logo.png" alt="" width="392" height="380" /></span>
      <span class="c-brand__text" aria-hidden="true">
        <strong>Capital Club</strong>
        <span>Asheville rooftop</span>
      </span>
    </a>
    <nav class="c-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="c-footer" id="contact">
    <Ridges class="c-footer__ridges" base="#16262f" layers={['#2f5068', '#25435a', '#1d3242']} />
    <div class="c-footer__body">
      <div class="c-footer__grid">
        <div class="c-footer__lead">
          <img src="/images/venue/logo.png" alt={venue.name} width="392" height="380" loading="lazy" />
          <p>Rooftop nights in the heart of downtown Asheville — big views, good company, and a calendar worth keeping.</p>
        </div>
        <div>
          <h2 class="c-footer__label">Find us</h2>
          <address>{venue.street}<br />{venue.city}, {venue.region} {venue.postalCode}</address>
          <a class="c-footer__link" href={venue.mapHref} target="_blank" rel="noopener">
            Get directions<span class="visually-hidden"> to {fullAddress()} (opens in a new tab)</span>
          </a>
        </div>
        <div>
          <h2 class="c-footer__label">Say hello</h2>
          <p><a class="c-footer__link" href={venue.phoneHref}>{venue.phone}</a></p>
          <p class="c-footer__muted">Event office hours by appointment</p>
        </div>
        <nav aria-label="Footer">
          <h2 class="c-footer__label">Explore</h2>
          <ul>{nav.map((item) => <li><a class="c-footer__link" href={item.href}>{item.label}</a></li>)}</ul>
        </nav>
      </div>
      <div class="c-footer__base">
        <p>© 2026 {venue.name}</p>
        <p>Demonstration site — reservations and messages are not processed.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
