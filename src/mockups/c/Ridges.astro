---
/**
 * Layered Blue Ridge silhouettes. Paths are generated deterministically (seeded noise +
 * Catmull-Rom smoothing) so every build draws the same mountains.
 */
interface Props {
  class?: string;
  /** Fill of the nearest ridge; should match the section that follows. */
  base?: string;
  layers?: string[];
}
const {
  class: className,
  base = '#1d3242',
  layers = ['#dde9ef', '#b7cfdc', '#86a8bd', '#557d97'],
} = Astro.props;

const W = 1440;
const H = 220;
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function ridge(seed: number, baseY: number, amp: number, step: number) {
  const r = rng(seed);
  const pts: [number, number][] = [];
  for (let x = -step; x <= W + step; x += step) {
    const wave = Math.sin((x / W) * Math.PI * (1.2 + seed * 0.13) + seed) * amp * 0.55;
    pts.push([x, baseY + wave + (r() - 0.5) * amp]);
  }
  let d = `M${pts[0]![0]},${H} L${pts[0]![0]},${pts[0]![1].toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)]!;
    const p1 = pts[i]!;
    const p2 = pts[i + 1]!;
    const p3 = pts[Math.min(pts.length - 1, i + 2)]!;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0]!.toFixed(1)},${c1[1]!.toFixed(1)} ${c2[0]!.toFixed(1)},${c2[1]!.toFixed(1)} ${p2[0]},${p2[1].toFixed(1)}`;
  }
  return `${d} L${pts[pts.length - 1]![0]},${H} Z`;
}
const fills = [...layers, base];
const paths = fills.map((fill, i) => ({
  fill,
  d: ridge(7 + i * 11, 70 + i * 30, 70 - i * 8, 120 + i * 10),
}));
---

<svg class={className} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  {paths.map((p) => <path d={p.d} fill={p.fill} />)}
</svg>
