---
/** Temporary holding page while a visual direction is chosen; replaced by the real homepage in the full build. */
import '@fontsource-variable/bodoni-moda/opsz.css';
import '../styles/holding.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The Capital Club of Asheville — Events (preview)" bodyClass="holding">
  <main id="main" tabindex="-1">
    <img src="/images/venue/logo.png" alt="The Capital Club of Asheville" width="392" height="380" />
    <h1>Rooftop events at The Capital Club</h1>
    <p>The events site is in design review. Three visual directions are ready to compare.</p>
    <a class="holding__cta" href="/mockups">View the design directions →</a>
    <small>Demonstration site — reservations and messages are not processed.</small>
  </main>
</BaseLayout>
