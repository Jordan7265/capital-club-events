---
import LayoutA from '../../../../mockups/a/LayoutA.astro';
import ReservationForm from '../../../../components/ReservationForm.astro';
import { events, venue, type VenueEvent } from '../../../../data/events';
import { dateParts, fullAddress, longDate, priceAmount, timeRange } from '../../../../lib/format';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: VenueEvent;
}

const { event } = Astro.props;
const d = dateParts(event.start);
const [mainTitle, subTitle] = event.title.split(' — ');
---

<LayoutA title={`${event.title} — The Capital Club of Asheville`} current="event" description={event.summary}>
  <section class="a-event-hero" aria-labelledby="a-event-title" style={`--pos:${event.image.position ?? '50% 50%'}`}>
    <div class="a-hero__media">
      <img src={event.image.src} alt={event.image.alt} width={event.image.width} height={event.image.height} fetchpriority="high" />
    </div>
    <div class="a-wrap a-event-hero__content">
      <p class="a-eyebrow a-reveal" style="--i:0">{event.kicker} · {d.weekdayLong}, {d.monthLong} {d.day}</p>
      <h1 class="a-display a-event-hero__title a-reveal" id="a-event-title" style="--i:1">
        {mainTitle}
        {subTitle && <span class="a-event-hero__sub"><span class="visually-hidden">: </span>{subTitle}</span>}
      </h1>
      <p class="a-event-hero__when a-reveal" style="--i:2">
        <span>{longDate(event.start)}</span>
        <span>{timeRange(event)}</span>
        <span>{priceAmount(event.price)} per {event.price.per}</span>
      </p>
    </div>
  </section>

  <div class="a-wrap a-event-body">
    <article>
      <div class="a-prose">
        {event.description.map((p) => <p>{p}</p>)}
      </div>

      <section class="a-ticket" aria-labelledby="a-details-title">
        <div class="a-ticket__main">
          <h2 class="visually-hidden" id="a-details-title">Event details</h2>
          <dl>
            <div><dt>Date</dt><dd>{longDate(event.start)}</dd></div>
            <div><dt>Time</dt><dd>{timeRange(event)}</dd></div>
            <div><dt>Catering</dt><dd>{event.catering}</dd></div>
            <div><dt>Entertainment</dt><dd>{event.entertainment}</dd></div>
            <div><dt>Attire</dt><dd>{event.attire}</dd></div>
            <div><dt>Venue</dt><dd>{venue.name}</dd></div>
          </dl>
        </div>
        <div class="a-ticket__stub">
          <span>Admit one</span>
          <strong>{priceAmount(event.price)}</strong>
          <span>per {event.price.per}</span>
          {event.price.note && <small>{event.price.note}</small>}
        </div>
        <div class="a-ticket__map">
          <address>{fullAddress()}</address>
          <a class="a-link" href={venue.mapHref} target="_blank" rel="noopener">
            Open in Maps<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </section>
    </article>

    <aside class="a-reserve" aria-labelledby="a-reserve-title" id="reserve-form">
      <p class="a-eyebrow">Reservations</p>
      <h2 class="a-reserve__title" id="a-reserve-title">Save your place</h2>
      <p class="a-reserve__lede">{d.weekday}, {d.month} {d.day} · {timeRange(event)} · up to 10 guests per reservation.</p>
      <ReservationForm event={event} variant="a" />
    </aside>
  </div>
</LayoutA>
