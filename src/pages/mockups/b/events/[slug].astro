---
import LayoutB from '../../../../mockups/b/LayoutB.astro';
import Ornament from '../../../../mockups/b/Ornament.astro';
import ReservationForm from '../../../../components/ReservationForm.astro';
import { events, venue, type VenueEvent } from '../../../../data/events';
import { dateParts, fullAddress, longDate, ordinal, priceAmount, timeRange } from '../../../../lib/format';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: VenueEvent;
}

const { event } = Astro.props;
const d = dateParts(event.start);
const [mainTitle, subTitle] = event.title.split(' — ');
---

<LayoutB title={`${event.title} — The Capital Club of Asheville`} current="event" description={event.summary} compact>
  <header class="b-feature-head">
    <p class="b-kicker">{event.kicker} · {d.weekdayLong}, {d.monthLong} {d.day}</p>
    <h1 class="b-headline">
      {mainTitle}
      {subTitle && <em><span class="visually-hidden">: </span>{subTitle}</em>}
    </h1>
    <p class="b-deck">{event.summary}</p>
    <p class="b-byline">
      <span>{longDate(event.start)}</span><span>{timeRange(event)}</span><span>{priceAmount(event.price)} per {event.price.per}</span>
    </p>
  </header>

  <figure class="b-figure b-feature-figure">
    <img
      src={event.image.src}
      alt={event.image.alt}
      width={event.image.width}
      height={event.image.height}
      style={event.image.position ? `object-position:${event.image.position}` : undefined}
      fetchpriority="high"
    />
    <figcaption><strong>On the Rooftop.</strong> {event.image.alt}</figcaption>
  </figure>

  <div class="b-feature-body">
    <article>
      <div class="b-columns">
        {event.description.map((p, i) => <p class={i === 0 ? 'b-dropcap' : undefined}>{p}</p>)}
      </div>
      <div class="b-getting-there">
        <div>
          <p class="b-smallcaps">Getting there</p>
          <address>{venue.name}, {fullAddress()}</address>
        </div>
        <a class="b-more" href={venue.mapHref} target="_blank" rel="noopener">
          Open the map<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </article>

    <aside class="b-glance" aria-labelledby="b-particulars-title">
      <h2 id="b-particulars-title">The Particulars</h2>
      <Ornament class="b-glance__orn" />
      <dl class="b-particulars">
        <div><dt>Date</dt><dd>{longDate(event.start)}</dd></div>
        <div><dt>Hours</dt><dd>{timeRange(event)}</dd></div>
        <div><dt>Catering</dt><dd>{event.catering}</dd></div>
        <div><dt>Entertainment</dt><dd>{event.entertainment}</dd></div>
        <div><dt>Attire</dt><dd>{event.attire}</dd></div>
        <div><dt>Place</dt><dd>{venue.street}, Asheville</dd></div>
      </dl>
      <p class="b-glance__price">
        <strong>{priceAmount(event.price)}</strong>
        <span>per {event.price.per}{event.price.note && ` · ${event.price.note.toLowerCase()}`}</span>
      </p>
      <a class="b-btn" href="#reply">Reply below</a>
    </aside>
  </div>

  <section class="b-reply" id="reply" aria-labelledby="b-reply-title">
    <div class="b-reply__inner">
      <div class="b-reply__head">
        <h2 class="b-reply__rsvp" id="b-reply-title">R.S.V.P.</h2>
        <p>The favour of a reply is requested for {mainTitle}, {d.weekdayLong}, the {ordinal(d.day)} of {d.monthLong}.</p>
      </div>
      <ReservationForm event={event} variant="b" submitLabel="Reserve my place" />
    </div>
  </section>
</LayoutB>
