---
import LayoutB from '../../../../mockups/b/LayoutB.astro';
import Ornament from '../../../../mockups/b/Ornament.astro';
import { upcomingEvents } from '../../../../data/events';
import { dateParts, eventsByMonth, priceAmount, timeRange } from '../../../../lib/format';

const base = '/mockups/b';
---

<LayoutB title="Upcoming Events — The Capital Club of Asheville" current="events" compact>
  <header class="b-page-head">
    <p class="b-kicker">Winter Season · 2026–27</p>
    <h1 class="b-headline">The Season’s Engagements</h1>
    <p class="b-deck">
      Seven evenings on the rooftop, from a benefit for Asheville’s playgrounds to a Valentine’s
      supper club. Reservations are taken online; parties of up to ten.
    </p>
  </header>

  {
    eventsByMonth(upcomingEvents).map(({ month, year, events: list }) => (
      <section aria-label={`${month} ${year}`}>
        <div class="b-month">
          <h2>
            <Ornament class="b-month__orn" />
            {month} {year}
          </h2>
        </div>
        <ol class="b-engagements">
          {list.map((e) => {
            const d = dateParts(e.start);
            return (
              <li class="b-engagement">
                <p class="b-engagement__date">
                  <strong>{d.day}</strong>
                  <span>{d.weekday}. {d.month}.</span>
                </p>
                <div>
                  <p class="b-kicker">{e.kicker}{e.featured && ' · The Benefit'}</p>
                  <div class="b-engagement__line">
                    <h3>
                      <a href={`${base}/events/${e.slug}`}>{e.title}</a>
                    </h3>
                    <span class="b-engagement__leader" aria-hidden="true" />
                    <span class="b-engagement__price">
                      {priceAmount(e.price)} <small>per {e.price.per}</small>
                    </span>
                  </div>
                  <p class="b-engagement__summary">{e.summary}</p>
                  <p class="b-engagement__meta">
                    {timeRange(e)} · {e.attire}
                  </p>
                  <p class="b-engagement__actions">
                    <a class="b-btn" href={`${base}/events/${e.slug}#reply`}>
                      Reserve<span class="visually-hidden"> for {e.title}</span>
                    </a>
                    <a class="b-more" href={`${base}/events/${e.slug}`}>
                      Read more<span class="visually-hidden"> about {e.title}</span>
                    </a>
                  </p>
                </div>
                <img src={e.image.src} alt="" width={e.image.width} height={e.image.height} loading="lazy" />
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</LayoutB>
