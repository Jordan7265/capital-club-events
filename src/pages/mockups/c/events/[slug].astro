---
import LayoutC from '../../../../mockups/c/LayoutC.astro';
import Ridges from '../../../../mockups/c/Ridges.astro';
import Icon from '../../../../mockups/c/Icon.astro';
import ReservationForm from '../../../../components/ReservationForm.astro';
import { events, venue, type VenueEvent } from '../../../../data/events';
import { dateParts, fullAddress, longDate, priceAmount, timeRange } from '../../../../lib/format';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: VenueEvent;
}

const { event } = Astro.props;
const base = '/mockups/c';
const d = dateParts(event.start);
const [mainTitle, subTitle] = event.title.split(' — ');
---

<LayoutC title={`${event.title} — The Capital Club of Asheville`} current="event" description={event.summary}>
  <header class="c-wrap c-event-head">
    <ol class="c-crumbs">
      <li><a href={base}>Home</a></li>
      <li><a href={`${base}/events`}>Events</a></li>
      <li aria-current="page">{mainTitle}</li>
    </ol>
    <h1 class="c-display">
      {mainTitle}
      {subTitle && <span><span class="visually-hidden">: </span>{subTitle}</span>}
    </h1>
    <div class="c-chips">
      <span class="c-chip c-chip--sun"><Icon name="calendar" /> {longDate(event.start)}</span>
      <span class="c-chip"><Icon name="clock" /> {timeRange(event)}</span>
      <span class="c-chip"><Icon name="hanger" /> {event.attire}</span>
      <span class="c-chip"><Icon name="ticket" /> {priceAmount(event.price)} per {event.price.per}</span>
    </div>
  </header>

  <div class="c-wrap c-event-grid">
    <div>
      <figure class="c-event-photo">
        <img
          src={event.image.src}
          alt={event.image.alt}
          width={event.image.width}
          height={event.image.height}
          style={event.image.position ? `object-position:${event.image.position}` : undefined}
          fetchpriority="high"
        />
        <Ridges class="c-hero__ridges" base="rgba(29,50,66,.6)" layers={['rgba(221,233,239,.28)', 'rgba(159,188,205,.4)']} />
      </figure>

      <section class="c-block" aria-labelledby="c-about-title">
        <h2 id="c-about-title">About the evening</h2>
        {event.description.map((p) => <p>{p}</p>)}
      </section>

      <section class="c-block" aria-labelledby="c-know-title">
        <h2 id="c-know-title">Good to know</h2>
        <dl class="c-goodtoknow">
          <div><Icon name="utensils" /><dt>Catering</dt><dd>{event.catering}</dd></div>
          <div><Icon name="music" /><dt>Entertainment</dt><dd>{event.entertainment}</dd></div>
          <div><Icon name="hanger" /><dt>Attire</dt><dd>{event.attire}</dd></div>
          <div><Icon name="clock" /><dt>When</dt><dd>{d.weekday}, {d.month} {d.day} · {timeRange(event)}</dd></div>
        </dl>
      </section>

      <section class="c-block" aria-labelledby="c-where-title">
        <h2 id="c-where-title">Getting there</h2>
        <div class="c-map">
          <svg viewBox="0 0 220 150" aria-hidden="true" focusable="false">
            <rect width="220" height="150" fill="#dde9ef"></rect>
            <path d="M-10 40 L230 70 M-10 110 L230 100 M60 -10 L40 160 M150 -10 L170 160" stroke="#fffdf9" stroke-width="9"></path>
            <path d="M-10 128 C 60 90, 140 70, 230 30" stroke="#f3b33d" stroke-width="12" fill="none"></path>
            <text x="150" y="40" font-size="10" font-weight="700" fill="#1d3242" font-family="sans-serif" transform="rotate(-24 150 40)">PATTON AVE</text>
            <circle cx="110" cy="72" r="22" fill="#c95c34" opacity=".18"></circle>
            <path d="M110 84 s-12-10.6-12-19.6a12 12 0 0 1 24 0c0 9-12 19.6-12 19.6z" fill="#c95c34"></path>
            <circle cx="110" cy="64" r="4.2" fill="#fffdf9"></circle>
          </svg>
          <div>
            <address>{venue.name}<br />{fullAddress()}</address>
            <a class="c-link" href={venue.mapHref} target="_blank" rel="noopener">
              Open in Maps<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </section>
    </div>

    <aside class="c-book" id="reserve" aria-labelledby="c-book-title">
      <h2 class="visually-hidden" id="c-book-title">Reserve your spot</h2>
      <p class="c-book__price"><strong>{priceAmount(event.price)}</strong><span>/ {event.price.per}</span></p>
      {
        event.price.note ? (
          <p class="c-book__note">
            <Icon name="heart" /> {event.price.note}
          </p>
        ) : (
          <p class="c-book__note">
            <Icon name="users" /> Up to 10 guests per reservation
          </p>
        )
      }
      <ReservationForm event={event} variant="c" guestControl="stepper" submitLabel="Reserve my spot" id="c-reserve" />
    </aside>
  </div>
</LayoutC>
