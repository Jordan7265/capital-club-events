---
import LayoutC from '../../../../mockups/c/LayoutC.astro';
import Icon from '../../../../mockups/c/Icon.astro';
import { upcomingEvents } from '../../../../data/events';
import { dateParts, eventsByMonth, priceAmount, timeRange } from '../../../../lib/format';

const base = '/mockups/c';
---

<LayoutC title="Upcoming Events — The Capital Club of Asheville" current="events">
  <header class="c-wrap c-page-head">
    <p class="c-eyebrow">Winter 2026–27 on the rooftop</p>
    <h1 class="c-display">What’s on</h1>
    <p>
      Seven nights between now and Valentine’s — benefits, bourbon, a makers market, live music and
      a New Year’s countdown above downtown. Reserve in under a minute.
    </p>
  </header>

  <div class="c-wrap c-timeline">
    {
      eventsByMonth(upcomingEvents).map(({ month, year, events: list }) => (
        <section class="c-month" aria-label={`${month} ${year}`}>
          <div class="c-month__label">
            <h2>{month}</h2>
            <span>
              {year} · {list.length} {list.length === 1 ? 'event' : 'events'}
            </span>
          </div>
          <ol class="c-month__list">
            {list.map((e) => {
              const d = dateParts(e.start);
              return (
                <li class:list={['c-row', { 'c-row--featured': e.featured }]}>
                  <div class="c-row__media">
                    <img
                      src={e.image.src}
                      alt=""
                      width={e.image.width}
                      height={e.image.height}
                      loading="lazy"
                      style={e.image.position ? `object-position:${e.image.position}` : undefined}
                    />
                    <span class="c-date" aria-hidden="true">
                      <span>{d.month}</span>
                      <strong>{d.day}</strong>
                    </span>
                  </div>
                  <div class="c-row__body">
                    {e.featured && (
                      <span class="c-flag">
                        <Icon name="heart" /> Next up · Benefit
                      </span>
                    )}
                    <p class="c-card__kicker">{e.kicker}</p>
                    <h3 class="c-row__title">
                      <a href={`${base}/events/${e.slug}`}>{e.title}</a>
                    </h3>
                    <div class="c-chips">
                      <span class="c-chip">
                        <Icon name="calendar" /> {d.weekday}, {d.month} {d.day}
                      </span>
                      <span class="c-chip">
                        <Icon name="clock" /> {timeRange(e)}
                      </span>
                      <span class="c-chip">
                        <Icon name="hanger" /> {e.attire}
                      </span>
                    </div>
                    <p class="c-row__summary">{e.summary}</p>
                    <div class="c-row__foot">
                      <p class="c-row__price">
                        <strong>{priceAmount(e.price)}</strong> <span>per {e.price.per}</span>
                      </p>
                      <a class="c-btn c-btn--clay" href={`${base}/events/${e.slug}#reserve`}>
                        Reserve<span class="visually-hidden"> for {e.title}</span> <Icon name="arrow" />
                      </a>
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</LayoutC>
