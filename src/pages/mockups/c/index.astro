---
import LayoutC from '../../../mockups/c/LayoutC.astro';
import Ridges from '../../../mockups/c/Ridges.astro';
import Icon from '../../../mockups/c/Icon.astro';
import { featuredEvent, upcomingEvents, venuePhotos } from '../../../data/events';
import { dateParts, priceAmount, timeRange } from '../../../lib/format';

const base = '/mockups/c';
const next = featuredEvent;
const nd = dateParts(next.start);
const more = upcomingEvents.filter((e) => e.slug !== next.slug).slice(0, 3);
const masonry = [
  'rooftop-wedding-party',
  'reception-dance-floor',
  'rooftop-ceremony-setup',
  'ballroom-evening-dinner',
  'rooftop-ceremony-kiss',
  'dinner-toast',
  'wedding-recessional',
  'rooftop-terrace-sunny',
  'reception-grand-entrance',
].map((k) => venuePhotos.find((p) => p.src.includes(k))!);
---

<LayoutC title="The Capital Club of Asheville — Rooftop Events" current="home">
  <section class="c-hero" aria-labelledby="c-hero-title">
    <div class="c-wrap c-hero__grid">
      <div>
        <p class="c-eyebrow">Rooftop events · Downtown Asheville</p>
        <h1 class="c-display c-hero__title" id="c-hero-title">
          Rooftop nights in the heart of{' '}
          <span class="c-swoosh"
            >Asheville<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"
              ><path
                d="M4 14 C 70 5, 160 2, 296 9"
                stroke="currentColor"
                stroke-width="9"
                fill="none"
                stroke-linecap="round"></path></svg
            ></span
          >
        </h1>
        <p class="c-hero__lede">
          Benefits, tastings and live music on a rooftop terrace with the whole Blue Ridge for a
          backdrop. Pick a night, bring your people, and we’ll save you a spot.
        </p>
        <div class="c-hero__actions">
          <a class="c-btn c-btn--clay" href={`${base}/events`}>See what’s on <Icon name="arrow" /></a>
          <a class="c-btn c-btn--ghost" href={`${base}/events/${next.slug}`}>Reserve for Nov {nd.day}</a>
        </div>
      </div>
      <figure class="c-arch">
        <span class="c-arch__sun" aria-hidden="true"></span>
        <img
          src="/images/venue/rooftop-dusk-string-lights.webp"
          alt="Guests on the rooftop terrace at dusk under string lights, the sun setting over the mountains."
          width="1632"
          height="1224"
          style="object-position:62% 50%"
          fetchpriority="high"
        />
        <a class="c-next" href={`${base}/events/${next.slug}`}>
          <span class="c-date" aria-hidden="true"><span>{nd.month}</span><strong>{nd.day}</strong></span>
          <span>
            <small>Next up · {nd.weekday}</small>
            <b>{next.title.split(' — ')[0]}</b>
          </span>
        </a>
      </figure>
    </div>
    <Ridges class="c-hero__ridges" />
  </section>

  <section class="c-dark" aria-labelledby="c-next-title">
    <div class="c-wrap">
      <div class="c-section-head">
        <div>
          <p class="c-eyebrow">Next on the rooftop</p>
          <h2 class="c-display c-section-title" id="c-next-title">Coming up this season</h2>
        </div>
        <a class="c-btn c-btn--light" href={`${base}/events`}>All events <Icon name="arrow" /></a>
      </div>

      <article class="c-feature">
        <div class="c-feature__media">
          <img src="/images/venue/rooftop-ceremony-mountain-view.webp" alt="Guests seated on the rooftop terrace with the Blue Ridge Mountains beyond." width="960" height="720" loading="lazy" />
          <span class="c-date" aria-hidden="true"><span>{nd.month}</span><strong>{nd.day}</strong></span>
        </div>
        <div class="c-feature__body">
          <span class="c-flag"><Icon name="heart" /> Benefit night</span>
          <h3 class="c-display c-feature__title">{next.title}</h3>
          <p>{next.summary}</p>
          <div class="c-chips">
            <span class="c-chip c-chip--dark"><Icon name="clock" /> {nd.weekday}, {nd.month} {nd.day} · {timeRange(next)}</span>
            <span class="c-chip c-chip--dark"><Icon name="utensils" /> Mikasa Catering</span>
            <span class="c-chip c-chip--dark"><Icon name="music" /> Live DJ</span>
            <span class="c-chip c-chip--dark"><Icon name="hanger" /> {next.attire}</span>
          </div>
          <div class="c-feature__foot">
            <p class="c-feature__price">
              <strong>{priceAmount(next.price)}</strong>
              <span>per person · {next.price.note?.toLowerCase()}</span>
            </p>
            <a class="c-btn c-btn--clay" href={`${base}/events/${next.slug}#reserve`}>Reserve <Icon name="arrow" /></a>
          </div>
        </div>
      </article>

      <div class="c-cards">
        {
          more.map((e) => {
            const d = dateParts(e.start);
            return (
              <article class="c-card">
                <div class="c-card__media">
                  <img src={e.image.src} alt="" width={e.image.width} height={e.image.height} loading="lazy" />
                  <span class="c-date" aria-hidden="true">
                    <span>{d.month}</span>
                    <strong>{d.day}</strong>
                  </span>
                </div>
                <div class="c-card__body">
                  <p class="c-card__kicker">{e.kicker}</p>
                  <h3 class="c-card__title">
                    <a href={`${base}/events/${e.slug}`}>{e.title}</a>
                  </h3>
                  <p class="c-card__meta">{d.weekdayLong}, {d.monthLong} {d.day} · {timeRange(e)}</p>
                  <p class="c-card__foot">
                    <span>{priceAmount(e.price)} <small style="font-weight:500;color:var(--muted)">/ {e.price.per}</small></span>
                    <span class="c-pill">Reserve <Icon name="arrow" /></span>
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="c-topo" aria-labelledby="c-venue-title">
    <div class="c-wrap c-venue">
      <div class="c-venue__text">
        <p class="c-eyebrow">The venue</p>
        <h2 class="c-display c-section-title" id="c-venue-title" style="margin-bottom:1.5rem">
          Big sky, right downtown
        </h2>
        <p>
          The Capital Club of Asheville sits at 82 Patton Avenue: a climate-controlled banquet room
          that opens onto a wide, open-air terrace with mountain and city views in every direction.
        </p>
        <p>
          There’s full bar service and a catering prep kitchen on site, and when the night winds
          down, all of downtown is an elevator ride away.
        </p>
        <div class="c-stats">
          <div><strong>15–175</strong><span>guests, seated or mingling</span></div>
          <div><strong>2 spaces</strong><span>banquet room + terrace</span></div>
          <div><strong>360°</strong><span>mountain &amp; city views</span></div>
        </div>
      </div>
      <div class="c-collage">
        <img src="/images/venue/building-exterior.webp" alt="The building at 82 Patton Avenue in downtown Asheville." width="380" height="552" loading="lazy" />
        <img src="/images/venue/rooftop-terrace-sunny.webp" alt="The open rooftop terrace with long mountain views." width="900" height="675" loading="lazy" />
        <img src="/images/venue/dining-room-mountain-windows.webp" alt="Dinner tables by the floor-to-ceiling windows of the banquet room." width="1800" height="1429" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="c-photos" id="photos" aria-labelledby="c-photos-title">
    <div class="c-wrap">
      <div class="c-section-head">
        <div>
          <p class="c-eyebrow">Photos</p>
          <h2 class="c-display c-section-title" id="c-photos-title">Up on the roof</h2>
        </div>
      </div>
      <div class="c-masonry">
        {masonry.map((p) => <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" />)}
      </div>
    </div>
  </section>
</LayoutC>
